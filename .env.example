# Database (Provided automatically by Railway PostgreSQL Plugin or external connection string)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# App URL (e.g. https://nestora.up.railway.app or http://localhost:2525)
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
APP_NAME="Nestora"
APP_ENV="production"

# Authentication Session Secret (generate a random 32+ char key)
AUTH_SECRET="change-this-to-a-very-secure-random-32-character-secret-key"

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_placeholder_webhook_secret"

# Email Notifications (Resend - Optional)
RESEND_API_KEY=""
EMAIL_FROM="orders@nestora.com"

# S3 / Cloudflare R2 Media Storage (Optional)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# Initial Admin Bootstrap (Optional)
ADMIN_BOOTSTRAP_EMAIL="admin@nestora.com"
ADMIN_BOOTSTRAP_PASSWORD="NestoraAdmin@2026"
